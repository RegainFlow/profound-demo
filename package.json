{
  "name": "profound-codex-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic Profound-flavored Codex workshop repo: harness engineering, PR gates, skills, hooks, and agent-native context.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "start": "tsx backend/server.ts",
    "test:backend": "node --import tsx --test backend/server.test.ts",
    "test:services": "node --import tsx --test services/campaign-export.test.ts services/csv-export.test.ts services/visibility-service.test.ts",
    "test": "npm run test:backend && npm run test:services",
    "lint:static": "tsx tools/lint/check-static.ts",
    "lint:boundaries": "tsx tools/lint/check-boundaries.ts",
    "lint": "npm run lint:static && npm run lint:boundaries",
    "gate": "npm run typecheck && npm run lint && npm test && npm run build:web && npm run e2e",
    "check": "npm run gate",
    "e2e:install": "playwright install chromium",
    "e2e": "tsx e2e/playwright.ts",
    "session-mine": "tsx tools/session-mining/mine-session.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "playwright": "^1.61.0",
    "tsx": "^4.22.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
